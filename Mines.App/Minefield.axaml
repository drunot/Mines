<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="using:Mines"
             x:Class="Mines.Minefield">

    <DockPanel>
      <!-- Bombs left on the left, the reset button in the middle, settings and the time on the right. -->
      <local:BevelFrame DockPanel.Dock="Top" Margin="5,5,5,5">
        <Grid Margin="5" ColumnDefinitions="*,Auto,*">
          <local:SegmentCounter x:Name="BombsLeftCounter" Grid.Column="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <!-- Reset button: a tile with a face showing the game state (normal, excited, won, dead). -->
          <local:FaceButton x:Name="ResetButton" Grid.Column="1" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <!-- Settings: opens the settings popup below it. -->
            <local:SettingsButton x:Name="SettingsButton" VerticalAlignment="Center"/>
            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding #SettingsButton}"
                   Placement="BottomEdgeAlignedRight" VerticalOffset="4" IsLightDismissEnabled="True">
              <local:SettingsPanel x:Name="SettingsPanel"/>
            </Popup>
            <local:SegmentClock x:Name="TimeCounter" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </local:BevelFrame>
      <!-- Sunken bevel frame (dark top and left, light bottom and right), mitred corner to corner. -->
      <local:BevelFrame Margin="5,0,5,5">
        <!-- The board fills the scroll box and starts zoomed to fit it; mouse wheel zooms in (never out past
             the fit), dragging or the scrollbars pan. -->
        <!-- SystemRegionBrush: the theme's normal window background (the window itself uses ClearBrush). -->
        <ScrollViewer Background="{DynamicResource HiddenBrush}"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <local:BoardView x:Name="BoardView"/>
        </ScrollViewer>
      </local:BevelFrame>
    </DockPanel>
</UserControl>

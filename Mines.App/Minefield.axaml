<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Mines.Minefield">

  
    <StackPanel>
      <DockPanel Margin="5" HorizontalSpacing="5">
        <Label VerticalAlignment="Center">Number of Bombs:</Label>
        <TextBox x:Name="BombTextBox"></TextBox>
        <Button Margin="5 0 0 0" x:Name="ResetButton">Reset</Button>
        <Label x:Name="BombsLeftLabel" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid x:Name="BoardGrid"/>
    </StackPanel>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Mines"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Mines.MainWindow"
        Title="Mines"
        Background="{DynamicResource HiddenBrush}">
    <!-- Rows and Columns are the defaults for the first start; after that the saved settings are used. -->
    <local:Minefield x:Name="Game" Rows="15" Columns="25"/>
</Window>

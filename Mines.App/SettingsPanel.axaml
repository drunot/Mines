<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="using:Mines"
             x:Class="Mines.SettingsPanel">

  <!-- The settings popup: window colour inside a raised bevel frame, like the rest of the app. -->
  <Border Background="{DynamicResource HiddenBrush}" CornerRadius="1">
    <local:BevelFrame IsRaised="True">
      <StackPanel Margin="12" Spacing="10" MinWidth="260">
        <TextBlock Text="Settings" FontWeight="Bold" FontSize="16"/>

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
          <TextBlock Grid.Row="0" Text="Rows" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="RowsInput"
                         Minimum="3" Maximum="200" Increment="1" FormatString="0"/>
          <TextBlock Grid.Row="1" Text="Columns" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="ColumnsInput"
                         Minimum="3" Maximum="200" Increment="1" FormatString="0"/>
          <TextBlock Grid.Row="2" Text="Bombs" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="BombsInput"
                         Minimum="1" Increment="1" FormatString="0"/>
        </Grid>

        <StackPanel Spacing="2">
          <TextBlock Text="Board generator" FontWeight="Bold"/>
          <RadioButton x:Name="NoGuessingOption" GroupName="Generator"
                       Content="No guessing: always solvable by logic"/>
          <RadioButton x:Name="ClassicOption" GroupName="Generator"
                       Content="Classic: random, may need a guess"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Classes="tile" x:Name="CancelButton" Content="Cancel"/>
          <Button Classes="tile" x:Name="NewGameButton" Content="New game"/>
        </StackPanel>
      </StackPanel>
    </local:BevelFrame>
  </Border>
</UserControl>

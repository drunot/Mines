<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Mines.Tile">
  <UserControl.Styles>
    <!-- Normal bevel -->
    <Style Selector="Border.bevel">
      <Setter Property="BorderThickness" Value="4"/>
      <Setter Property="BorderBrush">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="{DynamicResource BevelLight}" Offset="0.5"/>
          <GradientStop Color="{DynamicResource BevelDark}" Offset="0.5"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- While the mouse is over the button -->
    <Style Selector="Button:pointerover Border.bevel">
      <Setter Property="BorderBrush">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="{DynamicResource BevelLightHover}" Offset="0.5"/>
          <GradientStop Color="{DynamicResource BevelDarkHover}" Offset="0.5"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
    <!-- Revealed cells are flat: no bevel. The padding keeps the content the same size. -->
    <Style Selector="Button.revealed Border.bevel">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="18"/>
    </Style>
  </UserControl.Styles>

  <Button x:Name="TileButton" Width="32" Height="32" Padding="0">
    <Border Classes="bevel" CornerRadius="1">
      <Grid>
      <!-- resources/Flag.svg as vector shapes; colours come from the theme (FlagPoleBrush, FlagClothBrush). -->
      <Viewbox x:Name="FlagIcon" IsVisible="False" Margin="1">
        <Canvas Width="202.80916" Height="202.80916">
          <Canvas>
            <Canvas.RenderTransform>
              <TranslateTransform X="-3.5954208" Y="-4.3282442"/>
            </Canvas.RenderTransform>
            <Rectangle Canvas.Left="99.332062" Canvas.Top="17.519085" Width="11.335877" Height="147.98474"
                       Fill="{DynamicResource FlagPoleBrush}"/>
            <Path Fill="{DynamicResource FlagClothBrush}"
                  Data="M 99.332062,25.352991 V 61.58277 c 3.306338,27.065855 23.666828,18.343242 55.075738,23.60826 34.41846,5.769501 50.90822,21.16002 50.90822,21.16002 C 158.35962,50.454505 169.23346,24.46939 99.332062,25.352991 Z"/>
            <Rectangle Canvas.Left="50.587791" Canvas.Top="149.01527" Width="108.82442" Height="43.694656"
                       RadiusX="12.572519" RadiusY="12.572519" Fill="{DynamicResource FlagPoleBrush}"/>
            <Rectangle Canvas.Left="65.42749" Canvas.Top="128.60954" Width="79.145027" Height="35.038166"
                       RadiusX="10.081738" RadiusY="10.081738" Fill="{DynamicResource FlagPoleBrush}"/>
          </Canvas>
        </Canvas>
      </Viewbox>
      <!-- resources/Bomb.svg as a vector shape; colour from the theme (BombIconBrush).
           "F1" makes it fill with the nonzero rule, like SVG does by default. -->
      <Viewbox x:Name="BombIcon" IsVisible="False" Margin="1">
        <Canvas Width="202.80916" Height="202.80916">
          <Path Fill="{DynamicResource BombIconBrush}"
                Data="F1 m 99.022671,6.5952893 c -7.193541,0 -12.984737,5.7911967 -12.984737,12.9847367 V 33.784844 A 74.404572,74.404572 0 0 0 67.53312,41.450009 L 57.488772,31.405661 c -5.086601,-5.086601 -13.276619,-5.086601 -18.36322,0 l -8.452714,8.452714 c -5.086602,5.086602 -5.086602,13.276619 0,18.36322 L 40.717186,68.265944 A 74.404572,74.404572 0 0 0 33.052021,86.770757 H 18.847203 c -7.193541,0 -12.9847371,5.791197 -12.9847371,12.984737 V 111.7098 c 0,7.19354 5.7911961,12.98474 12.9847371,12.98474 h 14.204818 a 74.404572,74.404572 0 0 0 7.665165,18.50481 L 30.672838,153.2437 c -5.086602,5.0866 -5.086602,13.27662 0,18.36322 l 8.452714,8.45323 c 5.086601,5.0866 13.276619,5.0866 18.36322,0 L 67.53312,170.01581 a 74.404572,74.404572 0 0 0 18.504814,7.66464 v 14.20482 c 0,7.19354 5.791196,12.98474 12.984737,12.98474 h 11.954309 c 7.19354,0 12.98474,-5.7912 12.98474,-12.98474 v -14.20482 a 74.404572,74.404572 0 0 0 18.50481,-7.66464 l 10.04435,10.04434 c 5.0866,5.0866 13.27662,5.0866 18.36322,0 l 8.45323,-8.45323 c 5.0866,-5.0866 5.0866,-13.27662 0,-18.36322 l -10.04435,-10.04435 a 74.404572,74.404572 0 0 0 7.66465,-18.50481 h 14.20482 c 7.19354,0 12.98474,-5.7912 12.98474,-12.98474 V 99.755494 c 0,-7.19354 -5.7912,-12.984737 -12.98474,-12.984737 h -14.20482 a 74.404572,74.404572 0 0 0 -7.66465,-18.504813 l 10.04435,-10.044349 c 5.0866,-5.086601 5.0866,-13.276618 0,-18.36322 l -8.45323,-8.452714 c -5.0866,-5.086601 -13.27662,-5.086601 -18.36322,0 L 142.46653,41.450009 A 74.404572,74.404572 0 0 0 123.96172,33.784844 V 19.580026 c 0,-7.19354 -5.7912,-12.9847367 -12.98474,-12.9847367 z M 105.00008,50.084108 A 55.648849,55.648849 0 0 1 141.43094,63.666741 74.404572,74.404572 0 0 0 129.05856,62.630629 74.404572,74.404572 0 0 0 54.976781,130.11488 55.648849,55.648849 0 0 1 49.351284,105.73291 55.648849,55.648849 0 0 1 105.00008,50.084108 Z">
            <Path.RenderTransform>
              <TranslateTransform X="-3.5954208" Y="-4.3282442"/>
            </Path.RenderTransform>
          </Path>
        </Canvas>
      </Viewbox>
      <!-- resources/Question.svg as vector shapes; colour from the theme (QuestionIconBrush). Not used yet. -->
      <Viewbox x:Name="QuestionIcon" IsVisible="False" Margin="1">
        <Canvas Width="202.80916" Height="202.80916">
          <Canvas>
            <Canvas.RenderTransform>
              <TranslateTransform X="-3.5954208" Y="-4.3282442"/>
            </Canvas.RenderTransform>
            <Path Fill="{DynamicResource QuestionIconBrush}"
                  Data="F1 m 124.51718,71.85813 c 0,5.159705 -3.81369,11.21675 -8.52473,15.70345 -4.71103,4.4867 -12.33842,8.300395 -17.273791,14.58178 -7.403056,9.6464 -6.281381,20.86315 -6.281381,27.81754 v 2.24335 c 0,2.46768 2.019016,4.4867 4.486701,4.4867 h 22.433501 c 2.46768,0 4.4867,-2.01902 4.4867,-4.4867 v -2.24335 c 0,-10.54375 1.79468,-14.35744 10.31941,-20.63882 9.87074,-7.17872 21.7605,-20.41449 21.7605,-39.034295 0,-26.471531 -20.86316,-45.315672 -47.33469,-45.315672 -26.022862,0 -47.559022,21.536161 -47.559022,48.007692 v 3.365025 c 0,2.467685 2.019015,4.4867 4.4867,4.4867 h 22.4335 c 2.467685,0 4.4867,-2.019015 4.4867,-4.4867 v -3.813695 c 0,-8.524731 6.057046,-16.376456 16.152122,-16.376456 8.9734,0 15.92778,6.057045 15.92778,15.703451 z"/>
            <Ellipse Canvas.Left="88.903107" Canvas.Top="148.187217" Width="38.475246" Height="38.475246"
                     Fill="{DynamicResource QuestionIconBrush}"/>
          </Canvas>
        </Canvas>
      </Viewbox>
      <TextBlock x:Name="NumberText" IsVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Button>
</UserControl>
